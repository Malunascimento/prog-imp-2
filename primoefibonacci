        public static void preencherVetorFibonacci (int[] v, int n){
            if(n >= 1){
                v [0] = 0; 
                if(n >= 2){ 
                    v [1] = 1; 
                    for (int i = 2; i < n; i += 1){ 
                        v [i] = v [i - 1] + v[ i - 2];
                    }
                }
            }
        }
        public static boolean ehPrimo (int num){
            if(num < 2){ 
                return false;
            }
        for (int i = 2; i < num ; i += 1){ 
            if (num % i == 0){ 
                i += 1;
            return false; 
            }
        }
        return true; 
    }

        public static void preencherVetorPrimo(int[] v, int n){ 
            int numero = 2; 
            int i = 0; 
            while (i < n){ 
                if(ehPrimo(numero)){ 
                    v [i] = numero;
                    i += 1; 
                }
                numero += 1; 
            }
        }
        public static void preencherVetorSoma(int[] v,int n,  int[] a, int[] b){ 
            for(int i = 0; i < n; i +=1 ){ 
            v[i] = a[i] + b[n - i - 1]; 
