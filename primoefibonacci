                        posicao = i; 
                    }
                }
                  System.out.print("o maior número é " + maior + " e está na posição " + posicao);
                }
            
            public static void ordenarDecrescente(int[] v, int n){
                for (int p = 0; p < n - 1; p +=1) { 
